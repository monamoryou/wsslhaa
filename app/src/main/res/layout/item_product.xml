<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="3dp"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <!-- صورة المنتج بحواف دائرية -->
        <androidx.cardview.widget.CardView
            android:layout_width="80dp"
            android:layout_height="80dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp">

            <ImageView
                android:id="@+id/ivProductItemImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@android:drawable/ic_menu_gallery"/>
        </androidx.cardview.widget.CardView>

        <!-- تفاصيل المنتج (الاسم، الوصف، السعر) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginHorizontal="16dp">

            <TextView
                android:id="@+id/tvProductItemName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="اسم المنتج"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#1A1A1A"
                android:maxLines="1"/>

            <TextView
                android:id="@+id/tvProductItemDesc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="وصف المنتج المختصر يظهر هنا..."
                android:textSize="13sp"
                android:textColor="#757575"
                android:layout_marginTop="4dp"
                android:maxLines="2"/>
        </LinearLayout>

        <!-- السعر وزر الإضافة -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_gravity="center_vertical">

            <TextView
                android:id="@+id/tvProductItemPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0.00 ج.م"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#4CAF50"/>

            <Button
                android:id="@+id/btnAddToCart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="36dp"
                android:minWidth="0dp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:layout_marginTop="4dp"
                android:text="إضافة ➕"
                android:textColor="#4CAF50"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="?android:attr/selectableItemBackground"
                style="@android:style/Widget.DeviceDefault.Button.Borderless"/>
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>
