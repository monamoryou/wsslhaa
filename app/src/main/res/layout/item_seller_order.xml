<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="4dp"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- رأس البطاقة: رقم الطلب وحالته -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/tvOrderId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="طلب رقم #5432"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="#1A1A1A"/>

            <TextView
                android:id="@+id/tvOrderStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="قيد التجهيز"
                android:textColor="#FF9800"
                android:textStyle="bold"
                android:textSize="14sp"/>
        </RelativeLayout>

        <!-- تفاصيل المنتجات المطلوبة -->
        <TextView
            android:id="@+id/tvOrderItems"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="• 2x وجبة كرسبي عائلية\n• 1x علبة عصير طبيعي"
            android:textSize="15sp"
            android:textColor="#424242"
            android:layout_marginBottom="12dp"/>

        <!-- عنوان التوصيل وإجمالي الحساب -->
        <TextView
            android:id="@+id/tvDeliveryAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📍 التوصيل إلى: سمهود - بالقرب من المدرسة الإعدادية"
            android:textSize="13sp"
            android:textColor="#757575"
            android:layout_marginBottom="16dp"/>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="إجمالي حساب المنتجات:"
                android:textSize="14sp"
                android:textColor="#1A1A1A"/>

            <TextView
                android:id="@+id/tvTotalAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="340 ج.م"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="#4CAF50"/>
        </RelativeLayout>

        <!-- أزرار التحكم بالطلب -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2">

            <Button
                android:id="@+id/btnRejectOrder"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="رفض"
                android:textColor="#F44336"
                android:backgroundTint="#FFEBEE"/>

            <Button
                android:id="@+id/btnCallDriver"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="طلب موصلاتي 🚴"
                android:backgroundTint="#2196F3"
                android:textColor="#FFFFFF"/>
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>
